# ~/.config/zsh/zsh-aliases-mac
# macOS-only aliases. Sourced from .zshrc when $IS_MAC is set.

# Homebrew installs gcc/g++ with a version suffix; expose the unversioned name.
# Resolve the newest gcc-N / g++-N at startup so this survives major bumps.
alias gcc="${$(ls /opt/homebrew/bin/gcc-[0-9]* 2>/dev/null | sort -V | tail -1):-gcc}"
alias g++="${$(ls /opt/homebrew/bin/g++-[0-9]* 2>/dev/null | sort -V | tail -1):-g++}"
