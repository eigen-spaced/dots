;; Default config -- no home row mods (those live in hrm.kbd, run by
;; kanata-hrm).  Kanata needs the Karabiner VirtualHID driver to emit keys.
;;
;;   caps    tap esc, hold left ctrl
;;   ret     tap ret, hold right ctrl
;;   f5/f6   keyboard backlight down/up

(defcfg
  process-unmapped-keys no
)

(defsrc
  caps ret f5 f6
)

;; Eager hold: any other key pressed while held makes it ctrl immediately.
(defalias
  cap (tap-hold-press 300 300 esc lctl)
  ent (tap-hold-press 600 600 ret rctl))

(deflayer base
  @cap @ent bldn blup
)
